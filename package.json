{
  "name": "keycloakify-material",
  "version": "0.1.0",
  "type": "module",
  "description": "Angular + Vite Starter for Keycloakify 11",
  "repository": {
    "type": "git",
    "url": "git://github.com/keycloakify/keycloakify-starter-angular-vite.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-keycloak-theme": "ng build && node -e \"require('node:fs').rmSync('dist/keycloakify-dev-resources',{recursive:true,force:true})\" && keycloakify build",
    "test": "ng test",
    "lint": "ng lint --fix",
    "storybook": "ng run keycloakify-starter-angular-vite:storybook",
    "build-storybook": "ng run keycloakify-starter-angular-vite:build-storybook"
  },
  "author": "u/luca-peruzzo, u/kathari00, u/garronej",
  "license": "MIT",
  "keywords": [
    "angular",
    "keycloakify",
    "keycloak",
    "vite",
    "analog"
  ],
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@keycloakify/angular": "^22.1.0",
    "keycloakify": "^11.16.4",
    "oidc-spa": "^10.2.18",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/platform": "2.9.2",
    "@analogjs/storybook-angular": "^2.9.2",
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "^24.0.0",
    "@nx/vite": "^24.0.0",
    "@storybook/angular": "^10.6.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/types": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "esbuild": "^0.28.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "esbuild": "^0.28.0",
    "@analogjs/platform": {
      "vite": "$vite"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
